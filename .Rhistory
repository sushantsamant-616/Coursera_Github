# ------------------ Data Loading ------------------
data(mtcars)
str(mtcars)
# ------------------ Introducing Missing Values ------------------
mtcars_copy <- mtcars
mtcars_copy$mpg[c(5, 10, 15, 20)] <- NA
mtcars_copy$hp[c(3, 7, 12)] <- NA
mtcars_copy$wt[c(2, 6, 14)] <- NA
summary(mtcars_copy)
# ------------------ Finding Missing Values ------------------
# Total number of NA values
length(which(is.na(mtcars_copy)))
# Rows containing NA values (Method 1)
mtcars_NA <- mtcars_copy[!complete.cases(mtcars_copy), ]
mtcars_NA
# Rows containing NA values (Method 2)
mtcars_NA <- mtcars_copy[rowSums(is.na(mtcars_copy)) > 0, ]
mtcars_NA
# ------------------ Removing Rows with NA ------------------
mtcars_clean <- mtcars_copy[complete.cases(mtcars_copy), ]
length(which(is.na(mtcars_clean)))
# ------------------ Replacing NA Values ------------------
# Replace with Mean
mtcars_copy$mpg[is.na(mtcars_copy$mpg)] <-
mean(mtcars_copy$mpg, na.rm = TRUE)
# Replace with Median
mtcars_copy$hp[is.na(mtcars_copy$hp)] <-
median(mtcars_copy$hp, na.rm = TRUE)
# ------------------ Mode Function (for categorical data) ------------------
get_mode <- function(x) {
uniq <- unique(x)
uniq[which.max(tabulate(match(x, uniq)))]
}
# ------------------ Verify Replacement ------------------
colSums(is.na(mtcars_copy))
# ------------------ Boxplot Method ------------------
boxplot(mtcars[, 1:4], main = "Boxplot for Features", col = "lightblue")
# ------------------ IQR Method ------------------
detect_outliers <- function(x) {
Q1 <- quantile(x, 0.25)        # First Quartile
Q3 <- quantile(x, 0.75)        # Third Quartile
IQR_value <- Q3 - Q1           # Interquartile Range
lower_bound <- Q1 - 1.5 * IQR_value
upper_bound <- Q3 + 1.5 * IQR_value
return(which(x < lower_bound | x > upper_bound))
}
outliers <- lapply(mtcars[, 1:4], detect_outliers)
outliers
# ------------------ Scatterplot Visualization ------------------
pairs(mtcars[, 1:4], main = "Scatterplot Matrix")
# Convert numerical to categorical (for demonstration)
mtcars$cyl <- as.factor(mtcars$cyl)
# ------------------ Using model.matrix() ------------------
one_hot_data <- model.matrix(~cyl - 1, data = mtcars)
head(one_hot_data)
# ------------------ Combine Encoded Data ------------------
one_hot_data <- as.data.frame(one_hot_data)
mtcars_encoded <- cbind(mtcars[, 1:4], one_hot_data)
head(mtcars_encoded)
# ------------------ Using caret Package ------------------
install.packages("caret")
library(caret)
dummy_vars <- dummyVars(~ cyl, data = mtcars)
mtcars_transformed <- predict(dummy_vars, newdata = mtcars)
# ------------------ Min-Max Scaling ------------------
min_max_scaling <- function(x) {
return((x - min(x)) / (max(x) - min(x)))
}
mtcars_minmax <- as.data.frame(lapply(mtcars[, 1:4], min_max_scaling))
head(mtcars_minmax)
# ------------------ Z-Score Normalization ------------------
z_score_scaling <- function(x) {
return((x - mean(x)) / sd(x))
}
mtcars_zscore <- as.data.frame(lapply(mtcars[, 1:4], z_score_scaling))
head(mtcars_zscore)
# ------------------ Using caret for Scaling ------------------
preprocess_minmax <- preProcess(mtcars[, 1:4], method = "range")
mtcars_minmax_caret <- predict(preprocess_minmax, mtcars[, 1:4])
preprocess_zscore <- preProcess(mtcars[, 1:4], method = c("center", "scale"))
mtcars_zscore_caret <- predict(preprocess_zscore, mtcars[, 1:4])
# ------------------ Using poly() Function ------------------
mtcars_poly <- as.data.frame(
lapply(mtcars[, 1:4], function(x) poly(x, degree = 3, raw = TRUE))
)
head(mtcars_poly)
# ------------------ Using caret Package ------------------
poly_features <- preProcess(mtcars[, 1:4], method = "poly", degree = 3)
mtcars_poly_caret <- predict(poly_features, mtcars[, 1:4])
head(mtcars_poly_caret)
