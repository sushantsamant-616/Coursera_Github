library(caret)
dummy_vars <- dummyVars(~ cyl, data = mtcars)
mtcars_transformed <- predict(dummy_vars, newdata = mtcars)
# ------------------ Min-Max Scaling ------------------
min_max_scaling <- function(x) {
return((x - min(x)) / (max(x) - min(x)))
}
mtcars_minmax <- as.data.frame(lapply(mtcars[, 1:4], min_max_scaling))
head(mtcars_minmax)
# ------------------ Z-Score Normalization ------------------
z_score_scaling <- function(x) {
return((x - mean(x)) / sd(x))
}
dummy_vars <- dummyVars(~ cyl, data = mtcars)
mtcars_transformed <- predict(dummy_vars, newdata = mtcars)
# ------------------ Min-Max Scaling ------------------
min_max_scaling <- function(x) {
return((x - min(x)) / (max(x) - min(x)))
}
mtcars_minmax <- as.data.frame(lapply(mtcars[, c("mpg", "disp", "hp", "wt")], min_max_scaling))
head(mtcars_minmax)
# ------------------ Z-Score Normalization ------------------
z_score_scaling <- function(x) {
return((x - mean(x)) / sd(x))
}
mtcars_zscore <- as.data.frame(lapply(mtcars[, c("mpg", "disp", "hp", "wt")], z_score_scaling))
head(mtcars_zscore)
# ------------------ Using caret for Scaling ------------------
preprocess_minmax <- preProcess(mtcars[, c("mpg", "disp", "hp", "wt")], method = "range")
mtcars_minmax_caret <- predict(preprocess_minmax, mtcars[, c("mpg", "disp", "hp", "wt")])
preprocess_zscore <- preProcess(mtcars[, c("mpg", "disp", "hp", "wt")], method = c("center", "scale"))
mtcars_zscore_caret <- predict(preprocess_zscore, mtcars[, c("mpg", "disp", "hp", "wt")])
mtcars_poly <- as.data.frame(
lapply(mtcars[, 1:4], function(x) poly(x, degree = 3, raw = TRUE))
)
head(mtcars_poly)
# Step 1: Load dataset
data <- cars
head(data)
summary(data)
# 2. Normality
hist(cars$dist)
# 3. Linearity
plot(dist ~ speed, data = cars)
# Step 3: Linear Regression Model
speed.dist.lm <- lm(dist ~ speed, data = cars)
summary(speed.dist.lm)
# Step 4: Check Homoscedasticity
par(mfrow = c(2,2))
plot(speed.dist.lm)
par(mfrow = c(1,1))
# Install required packages
install.packages("ggplot2")
install.packages("ggpubr")
library(ggplot2)
library(ggpubr)
# 1. Plot data points
speed.graph <- ggplot(cars, aes(x = speed, y = dist)) +
geom_point()
speed.graph
# 2. Add regression line
speed.graph <- speed.graph +
geom_smooth(method = "lm", col = "black")
speed.graph
# 3. Add regression equation
speed.graph <- speed.graph +
stat_regline_equation(label.x = 10, label.y = 80)
speed.graph
# 4. Final styled graph
speed.graph +
theme_bw() +
labs(
title = "Distance as a function of Speed",
x = "Speed",
y = "Stopping Distance"
)
