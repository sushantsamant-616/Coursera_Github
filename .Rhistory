ylab = 'PROBABILITY',
xlab = 'SUCCESSSES',
lwd = 3)
# find pdf at x = 1 for standard normal
dnorm(1, mean = 0, sd = 1)
# by default mean=0 and sd=1
dnorm(1)
# find pdf at x = 18 with mean = 22 and sd = 6
dnorm(18, mean = 22, sd = 6)
# create sequence from -6 to 6
x <- seq(-6, 6, length = 120)
# height of pdf
y <- dnorm(x)
# plot curve
plot(x, y, type = "l", lwd = 2, xlab = "", ylab = "")
axis(1, at = -4:4,
labels = c("-4s","-3s","-2s","-1s","mean","1s","2s","3s","4s"))
